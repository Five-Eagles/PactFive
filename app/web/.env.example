# app/web 환경 변수 템플릿 — 실제 값은 .env.local에 넣는다 (커밋 금지)
#
# ⚠️ VITE_ 접두사는 "브라우저에 공개된다"는 뜻이다.
#    이 파일의 모든 값은 빌드 결과물에 평문으로 박혀 누구나 볼 수 있다.
#    비밀값(SERVICE_ROLE_KEY, PG_SECRET_KEY, LLM_API_KEY, DATABASE_URL)은
#    절대 여기에 넣지 않는다 — 서버 전용이다 (app/web/AGENTS.md "환경 변수" 참고).

# 백엔드 API 주소.
# 로컬 개발: 비워둔다 — vite.config.ts의 proxy가 /api를 localhost:3000으로 넘긴다.
# 배포: app/server Vercel 프로젝트의 주소를 넣는다 (예: https://pactfive-server.vercel.app)
VITE_API_BASE_URL=

# Supabase (공개 전제로 설계된 값만 — ADR-0008)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
