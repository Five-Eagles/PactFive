{
  "name": "pactfive-server",
  "private": true,
  "type": "module",
  "description": "PactFive 백엔드. Vercel 프로젝트의 Root Directory로 이 폴더를 지정한다 (ADR-0007). 구조 규칙은 app/server/AGENTS.md. Vercel Framework Preset은 반드시 'Other'로 설정한다 — 'Express'로 두면 zero-config 자동 감지가 번들을 건너뛰고 원본 src/express-app.ts를 직접 배포해 크래시가 난다 (2026-09-06 사고, AGENTS.md 참고).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/dev-server.ts",
    "bundle": "esbuild src/express-app.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=api/index.js",
    "build": "tsc --noEmit && npm run bundle",
    "postinstall": "npm run bundle",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "esbuild": "^0.24.2",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
